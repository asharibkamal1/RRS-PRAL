@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Reset Password · PRAL PER</PageTitle>

<div class="auth-wrap">
    <div class="auth-brand">
        <img src="img/pral-logo.svg" class="auth-logo" alt="PRAL" />
        <h1>PRAL</h1>
        <p>Performance Evaluation Report System</p>
    </div>

    <form method="post" action="/account/reset-password" class="auth-card" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="email" value="@Email" />

        <div class="otp-mail"><MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" /></div>
        <h2><MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Medium" /> Reset Password</h2>
        <p class="auth-hint">Enter the verification code sent to your email, then choose a new password.</p>

        @if (!string.IsNullOrEmpty(Info))
        {
            <div class="auth-info">@Info</div>
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }

        <label class="auth-label" for="code">Verification Code</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
               class="auth-input otp-input" placeholder="••••••" required autofocus />

        <PasswordField Id="password" Name="password" Label="New Password" Autocomplete="new-password" />
        <PasswordField Id="confirmPassword" Name="confirmPassword" Label="Confirm Password" Autocomplete="new-password" />

        <button type="submit" class="auth-btn">Reset Password</button>

        <div class="auth-row" style="justify-content:space-between;margin-top:12px">
            <a class="auth-link" href="/forgot-password">Didn't get a code?</a>
            <a class="auth-link" href="/">Back to Sign In</a>
        </div>
    </form>

    <div class="auth-footer">🔒 Secure Enterprise Access</div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
