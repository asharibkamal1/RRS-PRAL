@page "/set-password"
@layout AuthLayout
@attribute [Authorize]

<PageTitle>Set Password · PRAL PER</PageTitle>

<div class="auth-wrap">
    <div class="auth-brand">
        <img src="img/pral-logo.svg" class="auth-logo" alt="PRAL" />
        <h1>PRAL</h1>
        <p>Performance Evaluation Report System</p>
    </div>

    <form method="post" action="/account/set-password" class="auth-card" data-enhance="false">
        <AntiforgeryToken />

        <h2>Set Your Password</h2>
        <p class="auth-hint">Your account was created from HRMS with a temporary password.
            Choose a new password to continue.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }

        <label class="auth-label" for="password">New Password</label>
        <input id="password" name="password" type="password" class="auth-input"
               placeholder="••••••••" autocomplete="new-password" required />

        <label class="auth-label" for="confirmPassword">Confirm Password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" class="auth-input"
               placeholder="••••••••" autocomplete="new-password" required />

        <button type="submit" class="auth-btn">Save &amp; Continue</button>
    </form>

    <div class="auth-footer">🔒 Secure Enterprise Access</div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
