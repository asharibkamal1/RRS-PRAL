@page "/set-password"
@layout AuthLayout
@attribute [Authorize]
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Set Password · PRAL PER</PageTitle>

<div class="auth-wrap">
    <div class="auth-brand">
        <img src="img/pral-logo.svg" class="auth-logo" alt="PRAL" />
        <h1>PRAL</h1>
        <p>Performance Evaluation Report System</p>
    </div>

    <form method="post" action="/account/set-password" class="auth-card" data-enhance="false">
        <AntiforgeryToken />

        <h2><MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Medium" /> Create Your Password</h2>
        <p class="auth-hint">Your email is verified. Choose a new password to finish setting up
            your account — you'll use it to sign in from now on.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }

        <PasswordField Id="password" Name="password" Label="New Password" Autocomplete="new-password" />
        <PasswordField Id="confirmPassword" Name="confirmPassword" Label="Confirm Password" Autocomplete="new-password" />

        <button type="submit" class="auth-btn">Save &amp; Continue</button>
    </form>

    <div class="auth-footer">🔒 Secure Enterprise Access</div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Can't create a password until the emailed OTP has been verified.
        var state = await AuthState.GetAuthenticationStateAsync();
        if (!state.User.HasClaim(c => c.Type == "otp_verified"))
            Nav.NavigateTo("/verify-otp", forceLoad: true);
    }
}
