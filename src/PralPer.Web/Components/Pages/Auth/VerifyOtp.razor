@page "/verify-otp"
@layout AuthLayout
@attribute [Authorize]

<PageTitle>Verify Code · PRAL PER</PageTitle>

<div class="auth-wrap">
    <div class="auth-brand">
        <img src="img/pral-logo.svg" class="auth-logo" alt="PRAL" />
        <h1>PRAL</h1>
        <p>Performance Evaluation Report System</p>
    </div>

    <form method="post" action="/account/verify-otp" class="auth-card" data-enhance="false">
        <AntiforgeryToken />

        <h2>Enter Verification Code</h2>
        <p class="auth-hint">We emailed a one-time code to your registered email address.
            Enter it below to continue. The code expires shortly.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }
        @if (!string.IsNullOrEmpty(Info))
        {
            <div class="auth-info">@Info</div>
        }

        <label class="auth-label" for="code">Verification Code</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
               class="auth-input" placeholder="123456" required autofocus />

        <button type="submit" class="auth-btn">Verify &amp; Continue</button>
    </form>

    <form method="post" action="/account/resend-otp" data-enhance="false" style="margin-top:10px;text-align:center">
        <AntiforgeryToken />
        <button type="submit" class="auth-linkbtn">Resend code</button>
    </form>

    <div class="auth-footer">🔒 Secure Enterprise Access</div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }
}
