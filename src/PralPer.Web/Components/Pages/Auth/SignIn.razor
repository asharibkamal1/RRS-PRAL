@page "/"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject ICurrentUser CurrentUser
@inject ICaptchaService Captcha
@inject NavigationManager Nav

<PageTitle>Sign In · PRAL PER</PageTitle>

<div class="auth-wrap">
    <div class="auth-brand">
        <img src="img/pral-logo.svg" class="auth-logo" alt="PRAL" />
        <h1>PRAL</h1>
        <p>Performance Evaluation Report System</p>
    </div>

    <form method="post" action="/account/login" class="auth-card" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <h2><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Medium" /> Sign In</h2>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }
        @if (!string.IsNullOrEmpty(Info))
        {
            <div class="auth-info">@Info</div>
        }

        <label class="auth-label" for="email">Email Address / Employee ID</label>
        <input id="email" name="email" type="email" class="auth-input"
               placeholder="admin@pral.com.pk" autocomplete="username" required />

        <PasswordField Id="password" Name="password" Label="Password" Autocomplete="current-password" />

        <label class="auth-label" for="captcha">Security Check</label>
        <div class="captcha-row">
            <img id="captchaImg" class="captcha-img" src="@_challenge.ImageDataUri" alt="CAPTCHA challenge" />
            <button type="button" id="captchaRefresh" class="captcha-refresh" title="Get a new image" aria-label="Refresh CAPTCHA">↻</button>
        </div>
        <input id="captcha" name="captcha" type="text" class="auth-input" autocomplete="off"
               autocapitalize="characters" spellcheck="false" placeholder="Enter the characters above" required />
        <input type="hidden" id="captchaToken" name="captchaToken" value="@_challenge.Token" />

        <div class="auth-row">
            <label class="auth-check"><input type="checkbox" name="rememberMe" value="true" /> Remember me</label>
            <a class="auth-link" href="/forgot-password">Forgot Password?</a>
        </div>

        <button type="submit" class="auth-btn">Sign In</button>
    </form>

    <div class="auth-footer">🔒 Secure Enterprise Access</div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private CaptchaChallenge _challenge = default!;

    protected override void OnInitialized()
    {
        _challenge = Captcha.Generate();

        // Already signed in -> go to the appropriate dashboard.
        if (CurrentUser.IsAuthenticated)
        {
            var role = CurrentUser.ActiveRole
                ?? (CurrentUser.IsInRole(RoleNames.Admin) ? RoleNames.Admin
                    : CurrentUser.IsInRole(RoleNames.Manager) ? RoleNames.Manager
                    : CurrentUser.IsInRole(RoleNames.Employee) ? RoleNames.Employee : null);

            if (role is not null)
                Nav.NavigateTo(RoleRoutes.DashboardFor(role), forceLoad: true);
        }
    }
}
