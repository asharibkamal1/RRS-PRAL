@using PralPer.Application.Manager
@inject IManagerDashboardService Manager
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (_dto is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6" Style="font-weight:700">360° Competency Rating</MudText>
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">@_dto.PeriodName</MudText>
            </MudStack>

            <MudPaper Class="pa-4 mb-3" Elevation="0" Style="background:linear-gradient(90deg,#7C3AED,#A855F7);border-radius:12px;color:#fff">
                <MudText Typo="Typo.h6" Style="color:#fff;font-weight:700">@_dto.RaterName</MudText>
                <MudText Typo="Typo.body2" Style="color:#EDE9FE">@_dto.RaterJobTitle</MudText>
            </MudPaper>

            <div class="ratee-head">
                <span style="width:40px">SR</span>
                <span style="flex:1">RATEE NAME</span>
                <span style="width:120px">DEPARTMENT</span>
                <span style="width:120px">STATUS</span>
                <span style="width:90px;text-align:center">ACTION</span>
            </div>
            @foreach (var (r, idx) in _dto.Ratees.Select((x, i) => (x, i)))
            {
                <div class="ratee-row">
                    <span style="width:40px">@(idx + 1).</span>
                    <span style="flex:1;font-weight:600">@r.RateeName</span>
                    <span style="width:120px"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary">@r.Department</MudChip></span>
                    <span style="width:120px"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(r.Status == "Completed" ? Color.Success : Color.Warning)">@r.Status</MudChip></span>
                    <span style="width:90px;text-align:center">
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Disabled="true" />
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => OpenDetail(r.SnapshotId))" />
                    </span>
                </div>
            }
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public int RaterId { get; set; }
    private RaterEvaluationsDto? _dto;

    protected override async Task OnInitializedAsync()
        => _dto = await Manager.GetRaterEvaluationsAsync(RaterId);

    private async Task OpenDetail(int snapshotId)
    {
        var parameters = new DialogParameters<PeerEvaluationDetailDialog> { { x => x.SnapshotId, snapshotId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PeerEvaluationDetailDialog>("360° Competency Rating", parameters, options);
    }
}
