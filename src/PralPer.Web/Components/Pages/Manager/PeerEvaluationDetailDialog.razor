@using PralPer.Application.Manager
@inject IManagerDashboardService Manager

<MudDialog>
    <DialogContent>
        @if (_dto is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight:700">360° Competency Rating</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Peer review evaluation - @_dto.CompetenciesRated competency attributes</MudText>
                </div>
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">@_dto.PeriodName</MudText>
            </MudStack>

            <!-- Ratee banner -->
            <MudPaper Class="pa-4 mb-3" Elevation="0" Style="background:linear-gradient(90deg,#2563EB,#1D4ED8);border-radius:12px;color:#fff">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Style="color:#fff;font-weight:700">@_dto.RateeName</MudText>
                        <MudText Typo="Typo.body2" Style="color:#E0E7FF">@_dto.RateeJobTitle</MudText>
                    </MudStack>
                    <MudStack Spacing="0" AlignItems="AlignItems.End">
                        <MudText Typo="Typo.caption" Style="color:#C7D2FE">Evaluated by:</MudText>
                        <MudText Typo="Typo.body2" Style="color:#fff;font-weight:700">@_dto.RaterName</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <!-- Summary cards -->
            <MudGrid Class="mb-3">
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Average Rating</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800">@_dto.AverageRating.ToString("0.0")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">out of 10.0</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Competencies Rated</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800">@_dto.CompetenciesRated</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">total attributes</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3" Outlined="true" Style="background:#F0FDF4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Competency Assessment Score</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800;color:#16A34A">@_dto.AssessmentScorePercent.ToString("0.0")%</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Competency Weight = 100%</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Competency groups -->
            @foreach (var grp in _dto.Groups)
            {
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                        <span style="@($"width:6px;height:18px;border-radius:3px;background:{grp.Color}")"></span>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700">@grp.Competency</MudText>
                    </MudStack>

                    @foreach (var line in grp.Lines)
                    {
                        <div class="mb-3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1" Style="font-weight:600">@line.AttributeName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Remarks:</b> @line.Remarks</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Style="font-weight:700">@line.Score</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">out of @line.MaxScore</MudText>
                                </MudStack>
                            </MudStack>
                            <MudProgressLinear Color="Color.Primary" Value="@((double)line.Score / line.MaxScore * 100)" Rounded="true" Class="mt-1" />
                            <MudStack Row="true" Spacing="0" Class="mt-1">
                                @for (var s = 1; s <= line.MaxScore; s++)
                                {
                                    <MudIcon Size="Size.Small"
                                             Icon="@(s <= line.Score ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                             Style="@(s <= line.Score ? "color:#F59E0B" : "color:#CBD5E1")" />
                                }
                            </MudStack>
                        </div>
                    }
                </MudPaper>
            }

            <!-- Overall -->
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700" Class="mb-3">Overall Peer Evaluation Score</MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Category Breakdown</MudText>
                        @foreach (var grp in _dto.Groups)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-1">
                                <MudText Typo="Typo.body2" Style="flex:1">@grp.Competency</MudText>
                                <MudProgressLinear Value="@((double)grp.Average / 4 * 100)" Style="flex:1" Rounded="true" />
                                <MudText Typo="Typo.body2" Style="font-weight:700;width:36px;text-align:right">@grp.Average.ToString("0.0")</MudText>
                            </MudStack>
                        }
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-3" Outlined="true" Style="background:#F0FDF4;height:100%">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Competency Assessment Score</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight:800;color:#16A34A">@_dto.AssessmentScorePercent.ToString("0.0")%</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Competency Weight = 100%. Contributes 30% to the Final PER Score.</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public int SnapshotId { get; set; }
    private PeerEvaluationDetailDto? _dto;

    protected override async Task OnInitializedAsync()
        => _dto = await Manager.GetEvaluationDetailAsync(SnapshotId);
}
