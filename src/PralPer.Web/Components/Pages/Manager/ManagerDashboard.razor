@page "/manager/dashboard"
@attribute [Authorize(Policy = AuthPolicies.ManagerArea)]
@using PralPer.Application.Manager
@inject ICurrentUser CurrentUser
@inject IManagerDashboardService Manager
@inject IDialogService DialogService

<PageTitle>Manager Dashboard · PRAL PER</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Manager Dashboard</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-5">
    Good day, @CurrentUser.DisplayName! Here's your performance evaluation overview.
</MudText>

@if (_dto is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Team Evaluation Progress" Value="@($"{_dto.TeamEvaluationProgress:0}%")" Icon="@Icons.Material.Filled.TrendingUp" Accent="#2563EB" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Pending Approvals" Value="@_dto.PendingApprovals.ToString()" Icon="@Icons.Material.Filled.HourglassBottom" Accent="#D97706" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Average Team Score" Value="@_dto.AverageTeamScore.ToString("0.0")" Icon="@Icons.Material.Filled.Star" Accent="#16A34A" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Employees Awaiting Review" Value="@_dto.EmployeesAwaitingReview.ToString()" Icon="@Icons.Material.Filled.Groups" Accent="#7C3AED" /></MudItem>
    </MudGrid>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <MudText Typo="Typo.h6" Class="mb-3">Team Performance Overview</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@_teamSeries" XAxisLabels="@_teamLabels" Width="100%" Height="320px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <MudText Typo="Typo.h6" Class="mb-3">Pending Approvals</MudText>
                @foreach (var a in _dto.Approvals)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-2" Style="border-bottom:1px solid #F1F5F9">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Style="font-weight:600">@a.EmployeeName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@a.ApprovalType</MudText>
                        </MudStack>
                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@a.AgoText</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="mt-1">Review</MudButton>
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-6 mb-3">Your Team's Competency Rating Assignment overview.</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Total Evaluations Assigned" Value="@_dto.TotalEvaluationsAssigned.ToString()" Icon="@Icons.Material.Filled.Tag" Accent="#2563EB" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Pending Evaluations" Value="@_dto.PendingEvaluations.ToString()" Icon="@Icons.Material.Filled.HourglassBottom" Accent="#D97706" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Submitted Evaluations" Value="@_dto.SubmittedEvaluations.ToString()" Icon="@Icons.Material.Filled.CheckCircle" Accent="#16A34A" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Days Until Deadline" Value="@_dto.DaysUntilDeadline.ToString()" Icon="@Icons.Material.Filled.Event" Accent="#DC2626" /></MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <div class="ratee-head">
            <span style="width:40px">SR</span>
            <span style="flex:1">RATER NAME</span>
            <span style="width:120px">RATER STATUS</span>
            <span style="width:140px;text-align:center">EVALUATIONS ASSIGNED</span>
            <span style="width:200px">EVALUATION STATUS</span>
            <span style="width:80px;text-align:center">ACTION</span>
        </div>
        @{ var sr = 0; }
        @foreach (var r in _dto.Raters)
        {
            sr++;
            <div class="ratee-row">
                <span style="width:40px">@(sr).</span>
                <span style="flex:1;font-weight:600">@r.Name</span>
                <span style="width:120px">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(r.IsActiveRator ? Color.Tertiary : Color.Default)">Rator</MudChip>
                </span>
                <span style="width:140px;text-align:center;font-weight:600">@r.Assigned</span>
                <span style="width:200px">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">Completed: @r.Completed</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">Pending: @r.Pending</MudChip>
                </span>
                <span style="width:80px;text-align:center">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Disabled="@(r.Assigned == 0)" OnClick="@(() => OpenRater(r.RaterId))" />
                </span>
            </div>
        }
    </MudPaper>
}

@code {
    private ManagerHomeDto? _dto;
    private List<ChartSeries> _teamSeries = new();
    private string[] _teamLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        _dto = await Manager.GetHomeAsync();
        _teamLabels = _dto.Departments.Select(d => d.Department).ToArray();
        _teamSeries = new()
        {
            new ChartSeries { Name = "Completed", Data = _dto.Departments.Select(d => (double)d.Completed).ToArray() },
            new ChartSeries { Name = "Pending", Data = _dto.Departments.Select(d => (double)d.Pending).ToArray() }
        };
    }

    private async Task OpenRater(int raterId)
    {
        var parameters = new DialogParameters<RaterEvaluationsDialog> { { x => x.RaterId, raterId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<RaterEvaluationsDialog>("360° Competency Rating", parameters, options);
    }
}
