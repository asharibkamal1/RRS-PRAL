@page "/manager/dashboard"
@attribute [Authorize(Policy = AuthPolicies.ManagerArea)]
@using PralPer.Application.Dashboards
@inject ICurrentUser CurrentUser
@inject IDashboardService Dashboard

<PageTitle>Manager Dashboard · PRAL PER</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Manager Dashboard</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-5">
    Good day, @CurrentUser.DisplayName. Here's your team's evaluation overview.
</MudText>

@if (_dto is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Team Members" Value="@_dto.TeamMembers.ToString()" Icon="@Icons.Material.Filled.Groups" Accent="#2563EB" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Goals to Review" Value="@_dto.GoalsToReview.ToString()" Icon="@Icons.Material.Filled.TrackChanges" Accent="#D97706" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Pending Ratings" Value="@_dto.PendingRatings.ToString()" Icon="@Icons.Material.Filled.Star" Accent="#7C3AED" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><KpiCard Title="Approved PERs" Value="@_dto.ApprovedPers.ToString()" Icon="@Icons.Material.Filled.CheckCircle" Accent="#16A34A" /></MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-1">My Team — @_dto.ActiveCycleName</MudText>
        @if (_dto.Team.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No team members are reporting to you.</MudText>
        }
        else
        {
            @foreach (var m in _dto.Team)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-2" Style="border-bottom:1px solid #F1F5F9">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2" Style="font-weight:600">@m.EmployeeName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@m.Designation • @m.Department</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@m.Status</MudChip>
                </MudStack>
            }
        }
    </MudPaper>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
        Figures are fetched from the database (pre-calculated). Manager module action screens
        (assign raters, goal review, 360° rating, PER approval) follow in a later phase.
    </MudAlert>
}

@code {
    private ManagerDashboardDto? _dto;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.EmployeeId is int id)
            _dto = await Dashboard.GetManagerDashboardAsync(id);
    }
}
