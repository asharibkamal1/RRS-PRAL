@page "/manager/dashboard"
@attribute [Authorize(Policy = AuthPolicies.ManagerArea)]
@inject ICurrentUser CurrentUser

<PageTitle>Manager Dashboard · PRAL PER</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Manager Dashboard</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-5">
    Good day, @CurrentUser.DisplayName. Here's your team's evaluation overview.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Team Members" Value="8" Icon="@Icons.Material.Filled.Groups" Accent="#2563EB" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Goals to Review" Value="5" Icon="@Icons.Material.Filled.TrackChanges" Accent="#D97706" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Pending Ratings" Value="3" Icon="@Icons.Material.Filled.Star" Accent="#7C3AED" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Approved PERs" Value="2" Icon="@Icons.Material.Filled.CheckCircle" Accent="#16A34A" /></MudItem>
</MudGrid>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
    Manager module screens (Assign Raters, Goal review, 360° rating, PER approval) are scheduled
    after the Employee phase, reusing the same components and services.
</MudAlert>
