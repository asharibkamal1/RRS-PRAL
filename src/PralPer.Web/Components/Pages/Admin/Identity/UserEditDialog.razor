@using PralPer.Application.Identity
@using PralPer.Application.Services
@inject IIdentityAdminService Admin

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700">@(_isEdit ? "Edit User" : "Add User")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_model.Email" Label="Email (login)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudTextField @bind-Value="_model.DisplayName" Label="Display name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudTextField @bind-Value="_employeeIdText" Label="Employee Id (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                      InputMode="InputMode.numeric" Class="mb-3" />

        <MudSelect T="string" Label="Roles" MultiSelection="true" @bind-SelectedValues="_rolesSel"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            @foreach (var r in _roles) { <MudSelectItem T="string" Value="@r">@r</MudSelectItem> }
        </MudSelect>

        <MudSelect T="string" Label="Direct permissions (optional)" MultiSelection="true" @bind-SelectedValues="_permsSel"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            @foreach (var p in _perms) { <MudSelectItem T="string" Value="@p">@p</MudSelectItem> }
        </MudSelect>

        <MudSelect T="bool" @bind-Value="_model.IsActive" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            <MudSelectItem T="bool" Value="true">Active</MudSelectItem>
            <MudSelectItem T="bool" Value="false">Inactive</MudSelectItem>
        </MudSelect>

        @if (!_isEdit)
        {
            <MudTextField @bind-Value="_model.Password" Label="Password (leave blank to use the default + forced first-login reset)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? UserId { get; set; }

    private UserEditModel _model = new() { IsActive = true };
    private bool _isEdit => UserId is not null;
    private IReadOnlyList<string> _roles = Array.Empty<string>();
    private IReadOnlyList<string> _perms = Array.Empty<string>();
    private IEnumerable<string> _rolesSel = new HashSet<string>();
    private IEnumerable<string> _permsSel = new HashSet<string>();
    private string _employeeIdText = "";
    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _roles = await Admin.GetRoleNamesAsync();
        _perms = (await Admin.GetPermissionsAsync()).Where(p => p.IsActive).Select(p => p.Name).ToList();
        if (_isEdit)
            _model = await Admin.GetUserAsync(UserId!) ?? new UserEditModel { IsActive = true };
        _rolesSel = _model.Roles.ToHashSet();
        _permsSel = _model.Permissions.ToHashSet();
        _employeeIdText = _model.EmployeeId?.ToString() ?? "";
    }

    private async Task Save()
    {
        _error = null;
        _model.Roles = _rolesSel.ToList();
        _model.Permissions = _permsSel.ToList();
        _model.EmployeeId = int.TryParse(_employeeIdText, out var eid) ? eid : null;
        _saving = true;
        var res = _isEdit ? await Admin.UpdateUserAsync(_model) : await Admin.CreateUserAsync(_model);
        _saving = false;
        if (res.Succeeded) MudDialog.Close(DialogResult.Ok(true));
        else _error = res.Error;
    }

    private void Cancel() => MudDialog.Cancel();
}
