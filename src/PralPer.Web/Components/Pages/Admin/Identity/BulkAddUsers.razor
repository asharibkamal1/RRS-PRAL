@page "/admin/users/bulk"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PermissionPolicies.UsersCreate)]
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using PralPer.Application.Identity
@using PralPer.Application.Services
@inject IIdentityAdminService Admin
@inject ISnackbar Snackbar

<PageTitle>Bulk Add Users · PRAL PER</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700">Bulk Add Users</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Create many logins at once with a default password. Each user goes through the first-login OTP reset.
            Admin can <b>not</b> be assigned in bulk.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Href="/admin/users" StartIcon="@Icons.Material.Filled.ArrowBack">Back to Users</MudButton>
</MudStack>

<MudPaper Class="pa-3 mb-3" Outlined="true" Elevation="0">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_defaultPassword" Label="Default password for new users" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTabs Outlined="true" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="From Employees" Icon="@Icons.Material.Filled.Badge">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="3">
            <MudSelect T="string" @bind-Value="_employeeRole" Label="Assign role" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px">
                @foreach (var r in _nonAdminRoles) { <MudSelectItem T="string" Value="@r">@r</MudSelectItem> }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GroupAdd"
                       OnClick="CreateFromEmployees" Disabled="@(_selectedEmployees.Count == 0)">
                Create @_selectedEmployees.Count login(s)
            </MudButton>
        </MudStack>

        <MudTable T="ProvisionableEmployee" Items="_employees" MultiSelection="true" @bind-SelectedItems="_selectedEmployees"
                  Hover="true" Dense="true" Loading="_loading" Filter="EmployeeFilter">
            <ToolBarContent>
                <MudTextField @bind-Value="_empSearch" Placeholder="Search…" Immediate="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Name</MudTh><MudTh>Email</MudTh><MudTh>HR Code</MudTh><MudTh>Login?</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.HrCode</MudTd>
                <MudTd>
                    @if (context.HasLogin) { <MudChip T="string" Size="Size.Small" Color="Color.Default">Exists</MudChip> }
                    else { <MudChip T="string" Size="Size.Small" Color="Color.Success">New</MudChip> }
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Employees without a work email are skipped (no login id / OTP target).</MudText>
    </MudTabPanel>

    <MudTabPanel Text="From CSV / Excel" Icon="@Icons.Material.Filled.UploadFile">
        <MudText Typo="Typo.body2" Class="mb-2">
            Columns: <b>email, name, role</b> (one per line). Save an Excel sheet as <b>.csv</b> and upload it, or paste below.
        </MudText>
        <InputFile OnChange="LoadCsvFile" accept=".csv,.txt" class="mb-3" />
        <MudTextField @bind-Value="_csv" Label="CSV content (email,name,role)" Variant="Variant.Outlined"
                      Lines="8" Class="mb-3" Placeholder="jdoe@pral.com.pk,John Doe,Employee" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GroupAdd" OnClick="CreateFromCsv">Create from CSV</MudButton>
    </MudTabPanel>
</MudTabs>

@if (_lastResult is not null)
{
    <MudPaper Class="pa-3 mt-4" Outlined="true" Elevation="0">
        <MudText Typo="Typo.subtitle2">Result: created @_lastResult.Created, skipped @_lastResult.Skipped</MudText>
        @foreach (var e in _lastResult.Errors)
        {
            <MudText Typo="Typo.caption" Color="Color.Error">@e</MudText>
        }
    </MudPaper>
}

@code {
    private IReadOnlyList<ProvisionableEmployee> _employees = Array.Empty<ProvisionableEmployee>();
    private HashSet<ProvisionableEmployee> _selectedEmployees = new();
    private IReadOnlyList<string> _nonAdminRoles = Array.Empty<string>();
    private string _employeeRole = "Employee";
    private string _empSearch = "";
    private string _defaultPassword = "";
    private string _csv = "";
    private bool _loading = true;
    private BulkResult? _lastResult;

    protected override async Task OnInitializedAsync()
    {
        _defaultPassword = Admin.DefaultPassword;
        _nonAdminRoles = await Admin.GetRoleNamesAsync(excludeAdmin: true);
        _employeeRole = _nonAdminRoles.FirstOrDefault() ?? "Employee";
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        _loading = true;
        _employees = await Admin.GetProvisionableEmployeesAsync();
        _loading = false;
    }

    private bool EmployeeFilter(ProvisionableEmployee e) =>
        string.IsNullOrWhiteSpace(_empSearch)
        || e.Name.Contains(_empSearch, StringComparison.OrdinalIgnoreCase)
        || (e.Email ?? "").Contains(_empSearch, StringComparison.OrdinalIgnoreCase)
        || (e.HrCode ?? "").Contains(_empSearch, StringComparison.OrdinalIgnoreCase);

    private async Task CreateFromEmployees()
    {
        var rows = _selectedEmployees
            .Where(e => !string.IsNullOrWhiteSpace(e.Email))
            .Select(e => new BulkUserRow { Email = e.Email!, DisplayName = e.Name, Role = _employeeRole, EmployeeId = e.EmployeeId })
            .ToList();
        if (rows.Count == 0) { Snackbar.Add("No selected employees have a work email.", Severity.Warning); return; }
        _lastResult = await Admin.BulkCreateAsync(rows, _defaultPassword);
        Snackbar.Add($"Created {_lastResult.Created}, skipped {_lastResult.Skipped}.", Severity.Info);
        _selectedEmployees = new();
        await LoadEmployees();
    }

    private async Task LoadCsvFile(InputFileChangeEventArgs e)
    {
        using var reader = new StreamReader(e.File.OpenReadStream(5_000_000));
        _csv = await reader.ReadToEndAsync();
    }

    private async Task CreateFromCsv()
    {
        var rows = ParseCsv(_csv);
        if (rows.Count == 0) { Snackbar.Add("No rows to import.", Severity.Warning); return; }
        _lastResult = await Admin.BulkCreateAsync(rows, _defaultPassword);
        Snackbar.Add($"Created {_lastResult.Created}, skipped {_lastResult.Skipped}.", Severity.Info);
    }

    private static List<BulkUserRow> ParseCsv(string csv)
    {
        var rows = new List<BulkUserRow>();
        foreach (var raw in (csv ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var line = raw.Trim();
            if (line.Length == 0) continue;
            var cols = line.Split(',');
            var email = cols.ElementAtOrDefault(0)?.Trim() ?? "";
            if (email.Length == 0 || email.Contains("@") == false) continue;        // skips header / invalid
            rows.Add(new BulkUserRow
            {
                Email = email,
                DisplayName = cols.ElementAtOrDefault(1)?.Trim() ?? email,
                Role = cols.ElementAtOrDefault(2)?.Trim() ?? "Employee"
            });
        }
        return rows;
    }
}
