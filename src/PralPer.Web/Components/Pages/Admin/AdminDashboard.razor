@page "/admin/dashboard"
@attribute [Authorize(Policy = AuthPolicies.AdminArea)]
@inject ICurrentUser CurrentUser

<PageTitle>Administrator Dashboard · PRAL PER</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Administrator Dashboard</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-5">
    Good day, @CurrentUser.DisplayName. Here's your performance evaluation overview.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Total Employees" Value="20" Icon="@Icons.Material.Filled.Groups" Accent="#2563EB" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Evaluations Pending" Value="1" Icon="@Icons.Material.Filled.HourglassBottom" Accent="#D97706" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Completed Reviews" Value="2" Icon="@Icons.Material.Filled.CheckCircle" Accent="#16A34A" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Active Cycle" Value="Q1 2026" Icon="@Icons.Material.Filled.Autorenew" Accent="#7C3AED" /></MudItem>
</MudGrid>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
    Admin module screens (Evaluation/Rating periods, Attribute &amp; Designation administration,
    Assign Raters, PER reports) are scheduled after the Employee phase, on this same modular foundation.
</MudAlert>
