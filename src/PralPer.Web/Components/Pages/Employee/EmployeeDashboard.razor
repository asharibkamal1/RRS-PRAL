@page "/employee/dashboard"
@attribute [Authorize(Policy = AuthPolicies.EmployeeArea)]
@inject ICurrentUser CurrentUser

<PageTitle>Employee Dashboard · PRAL PER</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Employee Dashboard</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-5">
    Good day, @CurrentUser.DisplayName! Here's your performance evaluation overview.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Goal Completion Progress" Value="85%" Icon="@Icons.Material.Filled.TrackChanges" Accent="#16A34A" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Evaluation Status" Value="In Review" Icon="@Icons.Material.Filled.RateReview" Accent="#2563EB" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Final PER Score" Value="82.8" Icon="@Icons.Material.Filled.Star" Accent="#7C3AED" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><KpiCard Title="Pending Actions" Value="2" Icon="@Icons.Material.Filled.NotificationsActive" Accent="#D97706" /></MudItem>
</MudGrid>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
    Live dashboard data (My Goals Progress, Manager Feedback, Peer Rating Overview, Pending/Completed
    evaluations) is wired in the next Employee-phase step. The KPI cards above show the Figma layout.
</MudAlert>
