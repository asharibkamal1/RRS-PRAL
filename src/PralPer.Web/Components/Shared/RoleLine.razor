@* One role entry in the System Flow "User Roles" card. *@

<div class="pa-2 mb-2" style="@($"border-left:3px solid {Color};background:{Color}0F;border-radius:6px")">
    <MudText Typo="Typo.body2" Style="font-weight:700">@Name</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Desc</MudText>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Desc { get; set; } = string.Empty;
    [Parameter] public string Color { get; set; } = "#2563EB";
}
