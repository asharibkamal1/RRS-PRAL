@using PralPer.Application.Dashboards

<MudPaper Class="pa-4" Elevation="1" Style="height:100%">
    <MudText Typo="Typo.h6" Class="mb-3">@Title</MudText>
    @if (Items.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing here yet.</MudText>
    }
    else
    {
        @foreach (var item in Items)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-2" Style="border-bottom:1px solid #F1F5F9">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Style="font-weight:600">@item.EmployeeName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Designation • @item.Department</MudText>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if (Evaluatable)
                    {
                        @if (item.DaysLeft is int d)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@d days left</MudChip>
                        }
                        <MudButton Href="/employee/competency" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">Evaluate</MudButton>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@item.Status</MudChip>
                        @if (!string.IsNullOrEmpty(item.SubmittedOn))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.SubmittedOn</MudText>
                        }
                    }
                </MudStack>
            </MudStack>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<PeerEvaluationDto> Items { get; set; } = Array.Empty<PeerEvaluationDto>();

    /// <summary>Pending mode shows a "days left" chip + Evaluate button; otherwise a Submitted badge + date.</summary>
    [Parameter] public bool Evaluatable { get; set; }
}
